<xs:simpleType name="tipoDeVehiculo">
  <xs:restriction base="xs:string">
    <xs:enumeration value="barco"/>
    <xs:enumeration value="bicicleta"/>
    <xs:enumeration value="coche"/>
    <xs:enumeration value="tren"/>
  </xs:restriction>
</xs:simpleType>

<xs:element name="vehiculo" type="tipoDeVehiculo"/>

<!--Se define un tipo de dato simple llamado "tipoDeVehiculo"
que restringe sus valores a "barco", "bicicleta", "coche" y "tren".
Luego, se define el elemento "vehiculo" utilizando este tipo de
dato restringido "tipoDeVehiculo". Esto significa que el elemento
"vehiculo" solo puede tomar los valores permitidos por el tipo de
dato "tipoDeVehiculo".-->